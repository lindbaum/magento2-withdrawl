        <?php if (empty($items)): ?>
            <div class="message message-notice notice">
                <?= $escaper->escapeHtml(__('No items found for this withdrawal.')) ?>
            </div>
        <?php else: ?>
            <div class="admin__table-wrapper">
                <table class="data-table admin__table-secondary">
                    <thead>
                    <tr>
                        <th><?= $escaper->escapeHtml(__('Product Name')) ?></th>
                        <th><?= $escaper->escapeHtml(__('SKU')) ?></th>
                        <th class="col-qty"><?= $escaper->escapeHtml(__('Qty Withdrawn')) ?></th>
                    </tr>
                    </thead>
                    <tbody>
                    <?php foreach ($items as $item): ?>
                        <tr>
                            <td><?= $escaper->escapeHtml($item['order_item_name'] ?? '-') ?></td>
                            <td><?= $escaper->escapeHtml($item['order_item_sku'] ?? '-') ?></td>
                            <td class="col-qty">
                                <?php
                                $qty = (float)($item['qty_withdrawn'] ?? 0);
                                echo $escaper->escapeHtml(number_format($qty, 2));
                                ?>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        <?php endif; ?>
    </div>
</div>

